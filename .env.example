# Copy to ".env" and edit. Everything is optional.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Operator inbox key (open /admin). CHANGE THIS before sharing the app with anyone.
ADMIN_KEY=change-me-please
# Or store only its SHA-256 digest:
# ADMIN_KEY_HASH=

# Where the SQLite database and uploaded files are kept (default: backend/data)
# RELAYDROP_DATA_DIR=data

# Only if the UI is hosted elsewhere (e.g. GitHub Pages): comma-separated list of allowed UI origins
# CORS_ORIGINS=https://your-name.github.io
# SERVE_FRONTEND=0
